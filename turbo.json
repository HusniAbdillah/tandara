{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["VITE_API_BASE_URL"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build", "build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
