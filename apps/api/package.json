{
  "name": "@tandara/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "node --test test/*.test.mjs",
    "openapi": "node dist/export-openapi.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@tandara/backend": "workspace:*",
    "@tandara/contracts": "workspace:*",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "concurrently": "10.0.6"
  }
}
