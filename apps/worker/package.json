{
  "name": "@tandara/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@tandara/backend": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "bullmq": "6.3.15"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
