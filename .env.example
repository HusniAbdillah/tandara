# Local development only; copy to .env. Never use these credentials in a deployment.
NODE_ENV=development
DATABASE_URL=postgres://tandara:tandara_local_only@127.0.0.1:55432/tandara
POSTGRES_USER=tandara
POSTGRES_PASSWORD=tandara_local_only
POSTGRES_DB=tandara
POSTGRES_PORT=55432
REDIS_URL=redis://127.0.0.1:56379
REDIS_PORT=56379
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# SQL outbox worker: triage, independent source ingestion and retention.
WORKER_ENABLED=true
# Seed is explicitly simulation; external adapters remain disabled until authorized.
APP_MODE=simulation
DEMO_PASSWORD=replace-with-local-demo-password
AI_MODE=heuristic
# Set AI_MODE=compatible after replacing BOTH placeholders below.
# Temporary: vikey. Later: deepseek. Use custom for an approved compatible endpoint.
AI_PROVIDER=vikey
# Blank uses the provider default: Vikey https://api.vikey.ai/v1;
# DeepSeek https://api.deepseek.com. custom requires an explicit base URL.
AI_BASE_URL=
AI_MODEL=replace-with-model-id
AI_API_KEY=replace-with-api-key
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
# Optional embeddings are independent of the chat provider (DeepSeek chat does not imply an embedding API).
AI_EMBEDDING_MODE=disabled
AI_EMBEDDING_PROVIDER=vikey
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=replace-with-embedding-model-id
AI_EMBEDDING_API_KEY=replace-with-embedding-api-key
AI_EMBEDDING_DIMENSIONS=1536
# Illustrative conservative estimates, NOT quoted provider prices. Replace with approved upper bounds.
AI_INPUT_MICRO_USD_PER_MILLION_TOKENS=1000000
AI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=3000000
AI_EMBEDDING_MICRO_USD_PER_MILLION_TOKENS=10000000
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_MONTHLY_BUDGET_MICRO_USD=100000000
AI_ORG_DAILY_BUDGET_MICRO_USD=1000000
AI_RUN_MAX_MICRO_USD=1500000
AI_MAX_PENDING_PER_REGION=100
AI_MAX_CONCURRENT=4
AI_DATA_PROCESSING_APPROVED=false
# 32 random bytes as 64 lowercase hex characters. Required for MFA; keep in the secret manager.
MFA_ENCRYPTION_KEY=replace-with-64-hex-character-key
ALLOW_LIVE_SOURCES=false
SESSION_SECURE=false
