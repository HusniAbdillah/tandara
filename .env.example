# Local development only; copy to .env. Never use these credentials in a deployment.
NODE_ENV=development
DATABASE_URL=postgres://tandara:tandara_local_only@127.0.0.1:55432/tandara
POSTGRES_USER=tandara
POSTGRES_PASSWORD=tandara_local_only
POSTGRES_DB=tandara
POSTGRES_PORT=55432
REDIS_URL=redis://127.0.0.1:56379
REDIS_PORT=56379
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Implement consumers before enabling this. The worker process runs without an HTTP listener.
WORKER_ENABLED=false
# No production data or emergency workflow is enabled in this foundation.
APP_MODE=simulation
