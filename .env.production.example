# Copy into your secret manager; never commit the filled values.
NODE_ENV=production
APP_MODE=production
DATABASE_URL=postgres://tandara_app:replace-with-password@replace-with-private-database:5432/tandara?sslmode=verify-full&sslrootcert=/app/infrastructure/postgres/rds-ca-bundle.pem
REDIS_URL=redis://unused:6379
API_HOST=0.0.0.0
API_PORT=3000
WORKER_ENABLED=true
TRUST_PROXY=true
SESSION_SECURE=true
WEB_ORIGINS=https://replace-with-warga-domain,https://replace-with-posko-domain
MFA_ENCRYPTION_KEY=replace-with-64-hex-character-key
AI_MODE=disabled
AI_PROVIDER=vikey
AI_BASE_URL=
AI_MODEL=replace-with-model-id
AI_API_KEY=replace-with-api-key
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_EMBEDDING_MODE=disabled
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_API_KEY=replace-with-gemini-api-key
AI_EMBEDDING_DIMENSIONS=1536
# All costs below are placeholders (micro USD); set reviewed upper-bound prices and funded caps.
AI_INPUT_MICRO_USD_PER_MILLION_TOKENS=1000000
AI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=3000000
AI_EMBEDDING_MICRO_USD_PER_MILLION_TOKENS=10000000
AI_DAILY_BUDGET_MICRO_USD=5000000
AI_ORG_DAILY_BUDGET_MICRO_USD=1000000
AI_MONTHLY_BUDGET_MICRO_USD=100000000
AI_RUN_MAX_MICRO_USD=1500000
AI_MAX_PENDING_PER_REGION=100
AI_MAX_CONCURRENT=4
AI_DATA_PROCESSING_APPROVED=false
ALLOW_LIVE_SOURCES=false
LOG_LEVEL=info
# Set only to your organization's private collector; no auto-instrumentation or prompt capture.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tandara
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
