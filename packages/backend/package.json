    "test": "vitest run"
  },
  "dependencies": {
    "@tandara/contracts": "workspace:*",
    "@tandara/database": "workspace:*",
    "@nestjs/common": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pino": "10.4.0",
    "kysely": "0.29.6",
    "zod": "4.6.7"
  }
}
