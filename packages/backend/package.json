{
  "name": "@tandara/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@nestjs/common": "12.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@tandara/contracts": "workspace:*",
    "@tandara/database": "workspace:*",
    "fast-xml-parser": "5.11.2",
    "kysely": "0.29.6",
    "otpauth": "9.4.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
