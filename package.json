{
  "name": "tandara",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.22.0 <25",
    "pnpm": ">=10.26.2 <11"
  },
  "scripts": {
    "dev": "pnpm build && turbo run dev",
    "build:packages": "turbo run build --filter=@tandara/contracts --filter=@tandara/database --filter=@tandara/backend --filter=@tandara/api-client --filter=@tandara/ui",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tooling/tsconfig.json",
    "lint": "eslint . && node tooling/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test --concurrency=1",
    "test:deployment": "node --test tooling/deployment/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:tooling",
    "db:migrate": "turbo run build --filter=@tandara/database && pnpm --filter @tandara/database migrate",
    "db:seed": "turbo run build --filter=@tandara/database && pnpm --filter @tandara/database seed",
    "db:seed:demo": "turbo run build --filter=@tandara/database && pnpm --filter @tandara/database seed:demo",
    "test:e2e": "playwright test",
    "test:e2e:warga": "playwright test --config playwright.warga.config.ts",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "infra:up": "docker compose --env-file .env -f infrastructure/compose/compose.dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/compose/compose.dev.yml down",
    "test:integration": "pnpm build && node --env-file=.env --test --test-concurrency=1 tests/integration/*.test.mjs",
    "api:openapi": "turbo run build --filter=@tandara/api... && pnpm --filter @tandara/api openapi",
    "ai:verify": "turbo run build --filter=@tandara/backend... && node --env-file=.env tooling/verify-ai.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "ai:evaluate": "node tooling/run-ai-evaluation.mjs",
    "ai:score": "node tooling/score-ai-evaluation.mjs",
    "ai:load": "node tooling/load-ai.mjs",
    "production:onboard": "node tooling/onboard-production.mjs",
    "production:user": "node tooling/provision-production-user.mjs",
    "privacy:export": "node tooling/export-privacy-ledger.mjs",
    "privacy:backup": "node tooling/privacy-ledger-backup.mjs",
    "privacy:restore": "node tooling/restore-privacy.mjs",
    "dev:resident": "pnpm build:packages && pnpm --filter @tandara/resident-web dev",
    "dev:coordinator": "pnpm build:packages && pnpm --filter @tandara/coordinator-web dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
