# Deployment template: set real domains and provide built web assets.
# The API is exposed through each frontend origin, avoiding cross-origin cookies.
{$RESIDENT_DOMAIN} {
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv/warga
    try_files {path} /index.html
    file_server
  }
}

{$COORDINATOR_DOMAIN} {
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    root * /srv/posko
    try_files {path} /index.html
    header Cache-Control "no-store"
    file_server
  }
}
